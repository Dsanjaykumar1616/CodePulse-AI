# Copy this file to backend/.env and fill in the values.

# PostgreSQL connection (SQLAlchemy URL using the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://codepulse:codepulse@localhost:5432/codepulse

# Secret used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid, in minutes (default: 7 days)
JWT_EXPIRE_MINUTES=10080

# Frontend origin(s) allowed to call the API, comma-separated
CORS_ORIGINS=http://localhost:5173

# Optional: GitHub personal access token (no scopes needed for public repos).
# Raises the GitHub API rate limit used for issue analysis from 60 to 5000/hour.
GITHUB_TOKEN=

# Optional: largest repository (number of analyzed source files) for which
# per-file intelligence is precomputed for every file.
MAX_FILE_INTELLIGENCE=3000

LOG_LEVEL=INFO
